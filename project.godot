; Cinder Vale — Godot 4.4 project
; Original IP. No vault. macOS arm64 target.

config_version=5

[application]

config/name="Cinder Vale"
config/description="Grounded PNW-wasteland scavver RPG. Original IP."
run/main_scene="res://scenes/ui/Launcher.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

WorldState="*res://scripts/world/WorldState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

