# Editor / OS noise
*.tmp
.DS_Store

# Godot (reference tree) — engine cache, exports, source assets
godot-reference/.godot/
godot-reference/export/
godot-reference/build/
# Raw Mixamo FBX pack — >100 MB, not for redistribution. Drop your own into
# godot-reference/assets_src/ and run scripts/tools/build_character.gd once.
godot-reference/assets_src/

# JVM game — CC0 art packs (Poly Haven, ambientCG). Big; bundle locally.
# Downloads and unpack instructions in the pack READMEs.
jvm/src/main/resources/assets/env/

# JVM build outputs
jvm/.gradle/
jvm/build/
jvm/gradle/
!jvm/gradle/wrapper/
